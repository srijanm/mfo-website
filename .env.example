# Copy to .env.local and fill in. Never commit real values.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Where lead notifications are delivered.
LEAD_TO_EMAIL=

# Optional. Defaults to Resend's shared sender, which only delivers to the
# address that owns the Resend account. Set this to an address on a domain
# verified in Resend before going live.
LEAD_FROM_EMAIL=
